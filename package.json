{
  "name": "dsh-session-toolkit",
  "version": "1.0.0",
  "description": "Unified local plugin: session identity, global prompt, auto-resume, session log reposition, peer message (5 plugins consolidated).",
  "license": "MIT",
  "author": "dsh-session-toolkit maintainers",
  "repository": {
    "type": "git",
    "url": "https://github.com/Han-Yao94/dsh-session-toolkit.git"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "type": "module",
  "scripts": {
    "check": "node scripts/verify.mjs syntax",
    "verify": "node scripts/verify.mjs",
    "assert:clamp": "node scripts/clamp-call.assert.mjs",
    "assert:clamp:selftest": "node scripts/clamp-call.assert.mjs --selftest",
    "assert:workspace-prompt": "node scripts/workspace-prompt.guard.assert.mjs",
    "assert:workspace-prompt:selftest": "node scripts/workspace-prompt.guard.assert.mjs --selftest",
    "assert:group-prompt": "node scripts/group-prompt.contract.assert.mjs",
    "assert:group-prompt:selftest": "node scripts/group-prompt.contract.assert.mjs --selftest",
    "assert:session-search": "node scripts/session-search.assert.mjs",
    "assert:session-search:selftest": "node scripts/session-search.assert.mjs --selftest"
  },
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./client/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-cordis-client-runner"
      ]
    }
  }
}
